# Dependencies
node_modules/

# Build output (regenerated by `npm run build`)
dist/

# Local environment / secrets — never commit these
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Generated screenshots (regenerate any time with `npm run shots`)
screenshots/

# Local audit captures (regenerate any time with `npm run audit`)
pw-frames/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Optional: the original full-resolution source photo. The site only uses the
# optimised WebP copies in public/images/, so this file does not need to ship.
# (Safe to keep listed even if the file is not present.)
ahsan.jpg.jpeg
ahsan.jpg
